---
import Layout from '../layouts/Layout.astro'

import { profile } from '@/settings'
import { publications } from '@/data/cv'
import HiFlowsLogo from '@/assets/hiflows_logo.png'
import Hero from '@/components/ui/Hero.astro'
import Grid from '@/components/ui/Grid.astro'
import ArticleList from '@/components/ui/ArticleList.astro'

const { fullName, title, institute, research_areas } = profile

// Welcome to Steiner Lab! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<!-- Hero Section -->
	<section class='flex items-center gap-12 border-b pb-12'>
		<Hero
			fullName={fullName}
			title={title}
			institute={institute}
			profilePicture={HiFlowsLogo}
		/>
	</section>

	<!-- Research Areas -->
	<section class='py-12 border-b'>
		<ul class="space-y-4">
			{research_areas.map(area => (
				<li class="p-4 border rounded shadow">
					<h3 class="text-lg font-semibold">{area.title}</h3>
					<p class="text-gray-600">{area.description}</p>
				</li>
			))}
		</ul>
	</section>
	
	<!-- Recent Publications -->
    <section class='py-12 border-t'>
        <h2 class="text-2xl font-bold mb-6">Recent Publications</h2>
        <ul class="space-y-6">
            {publications.map(pub => (
				<li class="p-4 border rounded shadow">
					<h3 class="text-lg font-semibold">{pub.title}</h3>
					{pub.authors && <p class="text-gray-600 mb-1">{pub.authors}</p>}
					{pub.journal && <p class="text-gray-400 mb-1 italic">{pub.journal}</p>}
					{pub.time && <p class="text-gray-400 mb-1">Year: {pub.time}</p>}
					{pub.link && (
						<a href={pub.link} class="text-blue-600 underline" target="_blank" rel="noopener noreferrer">
							View Publication
						</a>
					)}
				</li>
            ))}
        </ul>
    </section>
</Layout>
