---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/settings";
import SocialIcons from "@/components/ui/SocialIcons.astro";

const { lab_members } = profile;
---

<Layout title="People">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-8">People</h1>
    <p class="text-lg mb-10">
      Meet the members of our lab. We are a diverse group of scientists, students, and collaborators working together to advance research and discovery.
    </p>

    <div class="grid gap-10 grid-cols-1 md:grid-cols-2">
      {
        lab_members?.map((member) => (
          <div class="flex items-start gap-6 bg-base-200 rounded-lg p-6 shadow">
            {member.photo && (
              <img
                src={member.photo}
                alt={member.name}
                class="w-24 h-24 object-cover rounded-full border-2 border-accent"
                loading="lazy"
              />
            )}
            <div>
              <h2 class="text-xl font-semibold mb-1">{member.name}</h2>
              <div class="text-base text-accent mb-2">{member.role}</div>
              <p class="mb-2">{member.bio}</p>
              {member.socials && <SocialIcons socials={member.socials} />}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>